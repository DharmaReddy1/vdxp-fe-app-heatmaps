<mvc:View
	controllerName="jnj.com.heatmap.dashboard.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:vizData="sap.viz.ui5.data"
	xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
	xmlns:html="http://www.w3.org/1999/xhtml">

	<Page id="mainPage" showHeader="false" backgroundDesign="List" class="fullWidthPage" width="100%">
		<content>
			<VBox class="dashboardRoot" width="100%">

				<!-- ═══ HEADER BAR ═══════════════════════════════════════════ -->
				<HBox class="dashboardHeader" alignItems="Center" justifyContent="SpaceBetween">
					<HBox alignItems="Center">
						<html:div class="appLogoWrap">
							<core:Icon id="greeringIcon" class="greetingMorningIcon"/>
						</html:div>
						<VBox class="sapUiTinyMarginBegin">
							<Title id="greetingTitle" text="{dashboard>/greeting} 👋" level="H3" class="greetingTitle"/>
							<Text text="Operational Intelligence · Risk Heatmap Dashboard" class="greetingSubtitle"/>
						</VBox>
					</HBox>
					<HBox alignItems="Center" class="headerActions">
						<Button
							text="Upload Data"
							icon="sap-icon://upload"
							press=".onNavigateToUpload"
							type="Transparent"
							class="headerBtn"/>
						<Button
							text="View All Risks"
							icon="sap-icon://list"
							press=".onViewAllRisks"
							type="Transparent"
							class="headerBtn"/>
						<Button
							icon="sap-icon://refresh"
							tooltip="Refresh dashboard"
							press=".onRefresh"
							type="Transparent"
							class="headerIconBtn"/>
						<Text text="{dashboard>/lastRefreshed}" class="refreshText"/>
					</HBox>
				</HBox>

				<!-- ═══ KPI TILES ROW ════════════════════════════════════════ -->
				<HBox class="kpiRow">
					<!-- Total RICEFs -->
					<VBox class="kpiCard kpiCardBlue">
						<HBox alignItems="Center" justifyContent="SpaceBetween">
							<Text text="Total RICEFs" class="kpiLabel"/>
							<core:Icon src="sap-icon://document-text" class="kpiIconSmall kpiIconBlue"/>
						</HBox>
						<Title text="{dashboard>/totalRICEFs}" level="H1" class="kpiValue"/>
					</VBox>
					<!-- Tier 1 Objects -->
					<VBox class="kpiCard kpiCardRed">
						<HBox alignItems="Center" justifyContent="SpaceBetween">
							<Text text="Tier 1 Objects" class="kpiLabel"/>
							<core:Icon src="sap-icon://triangle-task" class="kpiIconSmall kpiIconRed"/>
						</HBox>
						<Title text="{dashboard>/tier1Objects}" level="H1" class="kpiValue"/>
					</VBox>
					<!-- Immediate Action -->
					<VBox class="kpiCard kpiCardCritical">
						<HBox alignItems="Center" justifyContent="SpaceBetween">
							<Text text="Immediate Action" class="kpiLabel"/>
							<core:Icon src="sap-icon://status-negative" class="kpiIconSmall kpiIconRed"/>
						</HBox>
						<Title text="{dashboard>/immediateAction}" level="H1" class="kpiValue"/>
					</VBox>
					<!-- Mitigation Required -->
					<VBox class="kpiCard kpiCardOrange">
						<HBox alignItems="Center" justifyContent="SpaceBetween">
							<Text text="Mitigation Required" class="kpiLabel"/>
							<core:Icon src="sap-icon://warning2" class="kpiIconSmall kpiIconOrange"/>
						</HBox>
						<Title text="{dashboard>/mitigationRequired}" level="H1" class="kpiValue"/>
					</VBox>
					<!-- Monitor -->
					<VBox class="kpiCard kpiCardYellow">
						<HBox alignItems="Center" justifyContent="SpaceBetween">
							<Text text="Monitor" class="kpiLabel"/>
							<core:Icon src="sap-icon://history" class="kpiIconSmall kpiIconYellow"/>
						</HBox>
						<Title text="{dashboard>/monitor}" level="H1" class="kpiValue"/>
					</VBox>
					<!-- Controlled -->
					<VBox class="kpiCard kpiCardGreen">
						<HBox alignItems="Center" justifyContent="SpaceBetween">
							<Text text="Controlled" class="kpiLabel"/>
							<core:Icon src="sap-icon://accept" class="kpiIconSmall kpiIconGreen"/>
						</HBox>
						<Title text="{dashboard>/controlled}" level="H1" class="kpiValue"/>
					</VBox>
				</HBox>

				<!-- ═══ FILTER BAR ═══════════════════════════════════════════ -->
				<HBox class="filterBar" alignItems="End" wrap="NoWrap">
					<HBox alignItems="Center" class="filterBarLeft">
						<core:Icon src="sap-icon://filter" class="filterBarIcon"/>
						<Text text="Filters" class="filterBarLabel"/>
					</HBox>
					<VBox class="filterItem">
						<Label text="Release" class="filterLabel" labelFor="countryFilter"/>
						<Select id="countryFilter" change=".onFilterChange" class="filterSelect">
							<items>
								<core:Item key="" text="All Releases"/>
							</items>
						</Select>
					</VBox>
					<VBox class="filterItem">
						<Label text="Process Function" class="filterLabel" labelFor="processFilter"/>
						<Select id="processFilter" change=".onFilterChange" class="filterSelect">
							<items>
								<core:Item key="" text="All Process Functions"/>
							</items>
						</Select>
					</VBox>
					<VBox class="filterItem">
						<Label text="Complexity" class="filterLabel" labelFor="complexityFilter"/>
						<Select id="complexityFilter" change=".onFilterChange" class="filterSelect">
							<items>
								<core:Item key="" text="All Complexity"/>
								<core:Item key="High" text="High"/>
								<core:Item key="Medium" text="Medium"/>
								<core:Item key="Complex" text="Complex"/>
								<core:Item key="Low" text="Low"/>
							</items>
						</Select>
					</VBox>
					<VBox class="filterItem">
						<Label text="RICEFW Type" class="filterLabel" labelFor="riskCategoryFilter"/>
						<Select id="riskCategoryFilter" change=".onFilterChange" class="filterSelect">
							<items>
								<core:Item key="" text="All RICEFW Types"/>
							</items>
						</Select>
					</VBox>
					<VBox class="filterItem">
						<Label text="Risk Band" class="filterLabel" labelFor="riskBandFilter"/>
						<Select id="riskBandFilter" change=".onFilterChange" class="filterSelect">
							<items>
								<core:Item key="" text="All Risk Bands"/>
								<core:Item key="Critical / High" text="Critical / High"/>
								<core:Item key="Moderate" text="Moderate"/>
								<core:Item key="Low" text="Low"/>
							</items>
						</Select>
					</VBox>
					<VBox class="filterItem">
						<Label text="Readiness Band" class="filterLabel" labelFor="readinessBandFilter"/>
						<Select id="readinessBandFilter" change=".onFilterChange" class="filterSelect">
							<items>
								<core:Item key="" text="All Readiness Bands"/>
								<core:Item key="Low" text="Low"/>
								<core:Item key="Medium" text="Medium"/>
								<core:Item key="High" text="High"/>
							</items>
						</Select>
					</VBox>
					<Button
						text="Clear Filters"
						icon="sap-icon://clear-filter"
						press=".onResetFilters"
						class="resetButton"
						type="Transparent"
						enabled="{dashboard>/filtersActive}"/>
				</HBox>

				<!-- ═══ HEATMAP PANEL ════════════════════════════════════════ -->
				<VBox class="heatmapFullPanel panelCard">
					<HBox alignItems="Center" justifyContent="SpaceBetween" class="panelHeader">
						<HBox alignItems="Center">
							<core:Icon src="sap-icon://heat-stacked" class="panelHeaderIcon"/>
							<VBox class="sapUiTinyMarginBegin">
								<Title text="RICEF Risk × Readiness Heat Map" level="H4" class="panelTitle"/>
								<Text text="Click a cell to filter · Rows and columns show the workbook's risk and readiness bands" class="panelSubtitle"/>
							</VBox>
						</HBox>
						<HBox alignItems="Center">
							<SegmentedButton id="heatmapToggle" selectionChange=".onHeatmapToggle" contentMode="ContentFit" selectedKey="riskBand">
								<items>
									<SegmentedButtonItem key="riskBand" text="Risk Band Rows"/>
									<SegmentedButtonItem key="readinessBand" text="Readiness Rows"/>
								</items>
							</SegmentedButton>
						</HBox>
					</HBox>

					<!-- Heatmap container (rendered via JS) -->
					<html:div id="heatmapTableContainer" class="heatmapTableWrapper"/>

					<!-- Legend row -->
					<HBox class="heatmapLegend" alignItems="Center" justifyContent="SpaceBetween">
						<HBox alignItems="Center" class="legendGroup">
							<HBox alignItems="Center" class="legendItem">
								<html:span class="legendDot legendHigh"/>
								<Text text="Critical / High" class="legendText"/>
							</HBox>
							<HBox alignItems="Center" class="legendItem">
								<html:span class="legendDot legendMedium"/>
								<Text text="Moderate" class="legendText"/>
							</HBox>
							<HBox alignItems="Center" class="legendItem">
								<html:span class="legendDot legendLow"/>
								<Text text="Low" class="legendText"/>
							</HBox>
						</HBox>
						<Text text="Tip: Click a cell to filter the panels below" class="legendHint"/>
					</HBox>
				</VBox>

				<!-- ═══ BOTTOM PANELS ROW ════════════════════════════════════ -->
				<HBox class="bottomPanelsRow" alignItems="Stretch">

					<!-- Top Risk Areas -->
					<VBox class="bottomPanel panelCard">
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="panelHeader">
							<HBox alignItems="Center">
								<core:Icon src="sap-icon://status-negative" class="panelHeaderIcon panelHeaderIconRed"/>
								<Title text="Top Risk Areas" level="H4" class="panelTitle sapUiSmallMarginBegin"/>
							</HBox>
							<Link text="View all →" press=".onViewAllRisks" class="viewAllLink"/>
						</HBox>
						<List id="topRiskList" noDataText="No risks found" showSeparators="None" class="topRiskList " />
					</VBox>

					<!-- Risk Distribution -->
					<VBox class="bottomPanel panelCard">
						<HBox alignItems="Center" class="panelHeader">
							<core:Icon src="sap-icon://donutTitle"
								text="Risk Distribution"
								level="H4"
								class="panelTitle sapUiTinyMarginBegin"/>
							<Title text="Risk Distribution" level="H4" class="panelTitle sapUiTinyMarginBegin"/>
						</HBox>
						<HBox
							width="100%"
							height="259px"
							fitContainer="true"
							alignItems="Center">
							<!-- Chart -->
							<VBox width="65%">
								<viz:VizFrame
									id="donutViz"
									vizType="donut"
									width="100%"
									height="220px"
									renderComplete=".onDonutRenderComplete">

									<viz:dataset>
										<vizData:FlattenedDataset data="{/RiskDistribution}">
											<vizData:dimensions>
												<vizData:DimensionDefinition
													name="Criticality"
													value="{criticality}"/>
											</vizData:dimensions>

											<vizData:measures>
												<vizData:MeasureDefinition
													name="Count"
													value="{count}"/>
											</vizData:measures>
										</vizData:FlattenedDataset>
									</viz:dataset>

									<viz:feeds>
										<vizFeeds:FeedItem
											uid="size"
											type="Measure"
											values="Count"/>

										<vizFeeds:FeedItem
											uid="color"
											type="Dimension"
											values="Criticality"/>
									</viz:feeds>

								</viz:VizFrame>
							</VBox>

							<!-- Details -->
							<VBox
								id="donutLegend"
								width="35%"
								class="sapUiTinyMarginBegin">
							</VBox>

						</HBox>

					</VBox>

					<!-- Recent Investigation Queue -->
					<VBox class="bottomPanel panelCard">
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="panelHeader">
							<HBox alignItems="Center">
								<core:Icon src="sap-icon://activity-2" class="panelHeaderIcon panelHeaderIconOrange"/>
								<Title text="Investigation Queue" level="H4" class="panelTitle sapUiTinyMarginBegin"/>
							</HBox>
							<Link text="View all →" press=".onViewAllRisks" class="viewAllLink"/>
						</HBox>
						<List id="investigationList" noDataText="No open incidents" showSeparators="None" class="investigationList"/>
					</VBox>

					<!-- Complexity Profile -->
					<VBox class="bottomPanel panelCard">
						<HBox alignItems="Center" class="panelHeader">
							<core:Icon src="sap-icon://bar-chart" class="panelHeaderIcon panelHeaderIconGreen"/>
							<Title text="Complexity Profile" level="H4" class="panelTitle sapUiTinyMarginBegin"/>
						</HBox>
						<VBox id="complexityBars" class="complexityBars"/>
					</VBox>

				</HBox>

			</VBox>
		</content>
	</Page>

</mvc:View>
