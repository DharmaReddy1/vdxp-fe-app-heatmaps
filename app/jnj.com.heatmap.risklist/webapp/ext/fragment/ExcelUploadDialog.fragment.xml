<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:unified="sap.ui.unified">

	<Dialog
		id="excelUploadDialog"
		title="Import RICEFW Tracker"
		contentWidth="480px"
		resizable="true"
		draggable="true">

		<content>
			<VBox class="sapUiSmallMargin sapUiSmallMarginBottom">

				<!-- Instructions -->
				<MessageStrip
					text="Upload the readiness tracker workbook. The app imports the Tracker sheet and calculates risk scores, tiers, readiness bands, heat map status, and project response dates."
					type="Information"
					showIcon="true"
					class="sapUiSmallMarginBottom"/>

				<!-- File Uploader -->
				<Label text="Select Excel File" required="true" class="sapUiTinyMarginBottom"/>
				<unified:FileUploader
					id="dialogFileUploader"
					name="heatmapExcel"
					uploadUrl=""
					placeholder="Choose .xlsx or .xls file..."
					fileType="xlsx,xls"
					mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"
					maximumFileSize="10"
					change=".onDialogFileChange"
					typeMismatch=".onDialogFileTypeMismatch"
					fileSizeExceed=".onDialogFileSizeExceed"
					width="100%"
					style="Emphasized"/>

				<!-- Selected file name -->
				<Text
					id="dialogFileNameText"
					text="{excelUpload>/selectedFileName}"
					visible="{= !!${excelUpload>/selectedFileName} }"
					class="sapUiTinyMarginTop"/>

				<CheckBox
					id="replaceExistingCheck"
					text="Replace existing risk records"
					selected="{excelUpload>/replaceExisting}"
					class="sapUiSmallMarginTop"/>
				<MessageStrip
					text="This removes existing risks and related mitigation/action rows before importing the Tracker sheet. Replacement is disabled in production."
					type="Warning"
					showIcon="true"
					visible="{excelUpload>/replaceExisting}"
					class="sapUiTinyMarginTop"/>

				<!-- Busy indicator during upload -->
				<HBox
					visible="{excelUpload>/uploading}"
					alignItems="Center"
					class="sapUiSmallMarginTop">
					<core:Icon src="sap-icon://synchronize" class="sapUiTinyMarginEnd"/>
					<Text text="Uploading, please wait..."/>
				</HBox>

				<!-- Result strip after upload -->
				<MessageStrip
					id="dialogResultStrip"
					text="{excelUpload>/resultMessage}"
					type="{excelUpload>/resultType}"
					showIcon="true"
					visible="{excelUpload>/resultVisible}"
					class="sapUiSmallMarginTop"/>

			</VBox>
		</content>

		<buttons>
			<Button
				id="dialogUploadBtn"
				text="Upload"
				type="Emphasized"
				icon="sap-icon://upload"
				press=".onDialogUpload"
				enabled="{= ${excelUpload>/fileSelected} &amp;&amp; !${excelUpload>/uploading} }"/>
			<Button
				text="Close"
				press=".onDialogClose"/>
		</buttons>

	</Dialog>

</core:FragmentDefinition>
